   \n    Args:\n        trees: List of Shapely Polygons\n    \n    Returns:\n        float: Size of the square bounding box\n    \"\"\"\n    if not trees:\n        return 0.0\n    \n    # Get all coordinates\n    all_x = []\n    all_y = []\n    \n    for tree in trees:\n        coords = list(tree.exterior.coords)\n        for x, y in coords:\n            all_x.append(x)\n            all_y.append(y)\n    \n    if not all_x:\n        return 0.0\n    \n    # Calculate bounding box\n    min_x, max_x = min(all_x), max(all_x)\n    min_y, max_y = min(all_y), max(all_y)\n    \n    width = max_x - min_x\n    height = max_y - min_y\n    \n    # Return the size of the enclosing square\n    return max(width, height)\n\n\ndef parse_scalar(s_val):\n    \"\"\"Parse s-prefixed scalar value to float\"\"\"\n    s_val = str(s_val).strip()\n    if s_val.startswith('s'):\n        s_val = s_val[1:]\n    try:\n        return float(s_val)\n    except:\n        return 0.0\n\n\ndef configuration_is_valid(trees):\n    \"\"\"Check if a configuration has no collisions\"\"\"\n    n = len(trees)\n    for i in range(n):\n        for j in range(i + 1, n):\n            if trees_collide(trees[i], trees[j]):\n                return False\n    return True\n\n\nprint(\"=\"*80)\nprint(\"HELPER FUNCTIONS\")\nprint(\"=\"*80)\nprint(\"✓ trees_collide() - Collision detection\")\nprint(\"✓ calculate_bounding_box_size() - Box size calculation\")\nprint(\"✓ parse_scalar() - Parse s-values\")\nprint(\"✓ configuration_is_valid() - Validate configuration\")\nprint(\"\\nAll helper functions defined successfully\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-12-29T15:47:59.177783Z","iopub.execute_input":"2025-12-29T15:47:59.178653Z","iopub.status.idle":"2025-12-29T15:47:59.190217Z","shell.execute_reply.started":"2025-12-29T15:47:59.178621Z","shell.execute_reply":"2025-12-29T15:47:59.189258Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"\n\nclass TreePackingOptimizer:\n 